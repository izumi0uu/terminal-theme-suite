{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/izumi0uu/terminal-theme-suite/schemas/preset.schema.json",
  "title": "Terminal Theme Suite preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "order",
    "name",
    "description",
    "wallpaper",
    "ansi",
    "colors",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "preview": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.(?:png|jpg|jpeg|webp|heic)$"
    },
    "license_file": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.txt$"
    },
    "wallpaper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "blend", "image_mode"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.(?:png|jpg|jpeg|webp|heic)$"
        },
        "blend": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "image_mode": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ansi": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/color"
      }
    },
    "colors": {
      "type": "object",
      "required": [
        "background",
        "background_alt",
        "surface",
        "surface_alt",
        "foreground",
        "muted",
        "dim",
        "accent",
        "accent_alt",
        "red",
        "green",
        "yellow",
        "blue",
        "cyan",
        "teal",
        "orange",
        "pink",
        "selection"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/color"
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["herdr"],
      "properties": {
        "herdr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_theme", "panel_background"],
          "properties": {
            "base_theme": {
              "type": "string",
              "minLength": 1
            },
            "panel_background": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "omp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colors"],
          "properties": {
            "colors": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/color"
              }
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "overrides"],
          "properties": {
            "base": {
              "enum": [
                "dark",
                "light",
                "dark-daltonized",
                "light-daltonized",
                "dark-ansi",
                "light-ansi"
              ]
            },
            "overrides": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/color"
              }
            }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overrides"],
          "properties": {
            "overrides": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/color"
              }
            },
            "styles": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "comment",
                  "string",
                  "regex",
                  "number",
                  "constant",
                  "keyword",
                  "operator",
                  "storage",
                  "type",
                  "function",
                  "variable",
                  "parameter",
                  "property",
                  "tag",
                  "attribute",
                  "heading",
                  "link",
                  "punctuation",
                  "invalid",
                  "diff_added",
                  "diff_removed",
                  "diff_changed"
                ]
              },
              "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["bold", "italic", "underline"]
                }
              }
            }
          }
        },
        "hermes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overrides"],
          "properties": {
            "overrides": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "banner_border",
                  "banner_title",
                  "banner_accent",
                  "banner_dim",
                  "banner_text",
                  "ui_primary",
                  "ui_accent",
                  "ui_border",
                  "ui_text",
                  "ui_label",
                  "ui_ok",
                  "ui_error",
                  "ui_warn",
                  "prompt",
                  "input_rule",
                  "response_border",
                  "status_bar_bg",
                  "status_bar_text",
                  "status_bar_strong",
                  "status_bar_dim",
                  "status_bar_good",
                  "status_bar_warn",
                  "status_bar_bad",
                  "status_bar_critical",
                  "session_label",
                  "session_border",
                  "voice_status_bg",
                  "selection_bg",
                  "completion_menu_bg",
                  "completion_menu_current_bg",
                  "completion_menu_meta_bg",
                  "completion_menu_meta_current_bg",
                  "shell_dollar"
                ]
              },
              "additionalProperties": {
                "$ref": "#/$defs/color"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
